# Optional local settings. No API key or account is required.
PORT=3000
SERVER_NAME=local
# Public New York State Open Data (Socrata) Powerball dataset
API_BASE_URL=https://data.ny.gov/resource/d6yy-54nr.json
# Cache lifetime in seconds
CACHE_TTL=300
# Set true only when you deliberately want sample/demo data
USE_MOCK=false
