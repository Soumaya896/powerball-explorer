# Copy this file to ".env" and fill in your values:  cp .env.example .env
# The real .env is git-ignored and must NEVER be committed.

PORT=3000

# Your RapidAPI key (RapidAPI -> Powerball API -> Code Snippets -> header value)
API_KEY=

# Header that carries the key. The v2 playground shows "x-api-key".
# Older/other RapidAPI APIs use "X-RapidAPI-Key".
API_KEY_HEADER=x-api-key

# Base URL + host copied from the RapidAPI "Code Snippets" tab (cURL / Node).
API_BASE_URL=https://powerball.p.rapidapi.com
# Sent as the X-RapidAPI-Host header. Leave empty if the snippet has no such header.
API_HOST=powerball.p.rapidapi.com

# Endpoint paths. {placeholders} are filled in by the server.
# Copy the exact paths from the Code Snippets tab for each endpoint.
PATH_LATEST=/Latest
PATH_LATEST10=/Latest10
PATH_ALL=/AllDrawings
PATH_BY_DATE=/Drawing/{date}
PATH_BETWEEN=/DrawingsBetween/{first_date}/{second_date}

# Cache lifetime for API responses (seconds)
CACHE_TTL=300

# Force demo data (no API calls). Also used automatically when API_KEY is empty.
USE_MOCK=false
